{
  "name": "invariant",
  "version": "2.0.0",
  "private": true,
  "description": "An adaptive, explainable DSA practice platform.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "audit": "npm audit --audit-level=high && npm audit --audit-level=high --prefix docker/migrator",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:cleanup": "tsx scripts/cleanup-data.ts",
    "db:studio": "prisma studio",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dotenv": "17.4.2",
    "ioredis": "5.11.1",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "ts-fsrs": "5.4.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.8",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
